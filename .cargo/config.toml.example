# Android cross-compilation config for building the libretro core (.so).
#
# Copy this file to `.cargo/config.toml` and replace the linker paths below with
# your own Android NDK install. Only needed to build the `gb-libretro` cdylib for
# Android; host builds and the test suite need nothing here.
#
#   cargo build -p gb-libretro --release --target aarch64-linux-android
#
# The .cmd wrappers set the sysroot and API level (21). NDK r27 shown.

[target.aarch64-linux-android]
linker = "/path/to/Android/Sdk/ndk/<version>/toolchains/llvm/prebuilt/<host>/bin/aarch64-linux-android21-clang.cmd"
# Android 15+ requires 16 KB-aligned native libs or Play blocks the upload.
rustflags = ["-C", "link-arg=-Wl,-z,max-page-size=16384"]

[target.armv7-linux-androideabi]
linker = "/path/to/Android/Sdk/ndk/<version>/toolchains/llvm/prebuilt/<host>/bin/armv7a-linux-androideabi21-clang.cmd"
