# Build output
/target

# Deployed / built artifacts (regenerated by the build)
/deploy
/shots

# Editor / scratch
**/*.rs.bk
*.sav

# Machine-specific cargo config (Android NDK linker paths differ per machine).
# Copy .cargo/config.toml.example and set your own NDK path to cross-compile.
/.cargo/config.toml

# ROM images: ignore everywhere except the freely-distributable test ROMs
# (Blargg + dmg/cgb-acid2) that the test suite needs, and our own demo
# cartridge, which is CC0 and is the whole point of roms/.
*.gb
*.gbc
!tests/roms/**/*.gb
!tests/roms/**/*.gbc
!roms/pocketrust-demo/pocketrust-demo.gbc
!roms/hold-the-line/hold-the-line.gbc
/dumps

# The symbol listing is a build convenience, not a deliverable, EXCEPT for
# hold-the-line: crates/gb-core/tests/hold_the_line.rs reads its work RAM
# addresses out of that listing rather than hard-coding them, so without it the
# test suite does not run on a fresh clone.
*.sym
!roms/hold-the-line/hold-the-line.sym
